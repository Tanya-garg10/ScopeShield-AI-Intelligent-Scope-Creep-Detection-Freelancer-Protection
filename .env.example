# ScopeShield FastAPI backend URL. In production, set this to your public HTTPS backend URL.
VITE_API_URL="http://localhost:8000"

# Optional Ollama settings. These VITE_ values are included in the browser bundle;
# only set an endpoint that visitors' browsers are allowed to reach.
VITE_OLLAMA_HOST="http://localhost:11434"
VITE_OLLAMA_MODEL="qwen3:4b-instruct"
