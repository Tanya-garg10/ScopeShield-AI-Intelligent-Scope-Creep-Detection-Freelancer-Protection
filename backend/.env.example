# ScopeShield AI Backend Configuration
# Port for FastAPI server
PORT=8000
HOST=0.0.0.0

# Gemini AI (keep the real key on the backend; never use a VITE_ prefix)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Local AI Inference via Ollama
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen3:4b-instruct

# SQLite Storage Path
SQLITE_DB_PATH=scopeshield.db
